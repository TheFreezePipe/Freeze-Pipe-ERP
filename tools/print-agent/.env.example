# Freeze Pipe print agent. Copy to .env (git-ignored) and fill in.
# The project URL and the anon (public) key, as in the web app's VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# The dedicated print-agent login. Its profile must carry is_print_agent, which only the database owner can set.
AGENT_EMAIL=print-agent@freezepipe.test
AGENT_PASSWORD=

# This installation's name. The agent prints the jobs of the active printers whose agent_id is this value.
AGENT_ID=agent-dock

# Optional
# AGENT_DATA_DIR=./data          # where the sent-jobs journal lives (never re-send a job)
# POLL_SECONDS=15                # claim at least this often, Realtime or not
# HEARTBEAT_SECONDS=30           # last_seen_at in Settings > Warehouse > Printers
# SEND_TIMEOUT_MS=10000          # per tcp:// send; share:// gets three times this
